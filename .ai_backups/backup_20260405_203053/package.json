{
  "name": "chronicles-of-meterea",
  "version": "0.3.5",
  "description": "AI Text RPG Adventure",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "author": "MrKins_XP",
  "license": "MIT",
